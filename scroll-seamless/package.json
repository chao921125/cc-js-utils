{
  "name": "scroll-seamless",
  "version": "2.1.0",
  "type": "module",
  "description": "A high-performance, feature-rich seamless scrolling library supporting JavaScript, Vue 3, and React",
  "main": "dist/core/index.cjs",
  "module": "dist/core/index.esm.js",
  "types": "dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.esm.js",
      "require": "./dist/core/index.cjs"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.esm.js",
      "require": "./dist/core/index.cjs"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.esm.js",
      "require": "./dist/vue/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.esm.js",
      "require": "./dist/react/index.cjs"
    },
    "./types": {
      "types": "./dist/types/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.en.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite --open",
    "build": "rollup -c rollup.config.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts,.tsx,.vue",
    "format": "prettier --write 'src/**/*.{ts,tsx,vue}'",
    "type-check": "tsc --noEmit",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build && npm run test:run",
    "release": "npm publish",
    "release:beta": "npm publish --tag beta"
  },
  "keywords": [
    "scroll",
    "seamless",
    "marquee",
    "carousel",
    "vue",
    "react",
    "typescript",
    "performance",
    "virtual-scroll",
    "animation"
  ],
  "author": "huangchao",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chao921125/cc-js-utils.git",
    "directory": "scroll-seamless"
  },
  "bugs": {
    "url": "https://github.com/chao921125/cc-js-utils/issues"
  },
  "homepage": "https://github.com/chao921125/cc-js-utils/tree/main/scroll-seamless#readme",
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/compiler-sfc": "^3.5.45",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rollup": "^4.68.2",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-vue": "6.0.0",
    "tslib": "^2.9.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "vue": "^3.5.45"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  }
}
